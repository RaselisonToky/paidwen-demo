# Norbill configuration.
# Every value has a default in docker-compose.yml, so "docker compose up" works without this file.
# Copy it to .env to change a value.

# Postgres connection string used by the API and the worker.
DATABASE_URL=postgres://norbill:norbill@db:5432/norbill

# Redis connection string used by the API (queue producer) and the worker (queue consumer).
REDIS_URL=redis://redis:6379

# Public URL of the web app. It is used in email links and in the Stripe redirect URLs.
APP_URL=http://localhost:3000

# URL of the API as seen from the web container. The browser never calls the API directly.
API_URL=http://api:4000

# Secret that signs the session cookie. Change it before any real use.
SESSION_SECRET=change-me-before-going-to-production

# SMTP relay used by the worker. No authentication by default.
# Leave SMTP_HOST empty and the worker prints the emails in its log instead of sending them.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Norbill <no-reply@norbill.test>

# Stripe. Leave STRIPE_SECRET_KEY empty and the billing page says that payments are not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Optional base URL for the Stripe API, for example http://stripe-mock:12111. Empty means api.stripe.com.
STRIPE_API_BASE=

# Set to "production" to refuse Stripe webhooks that are not signed.
NODE_ENV=development
